execution-verb-name = Execute
execution-verb-message = Use your weapon to execute someone.

# All the below localisation strings have access to the following variables
# attacker (the person committing the execution)
# victim (the person being executed)
# tool (the tool used for the execution)

# ballistic
execution-before-popup-ballistic = {CAPITALIZE($attacker)} presses the barrel of {THE($tool)} against the side of {$victim}'s head.
execution-before-popup-ballistic-self = {CAPITALIZE($attacker)} presses the barrel of {THE($tool)} against the side of {POSS-ADJ($victim)} head.
execution-after-popup-ballistic = {CAPITALIZE($attacker)} shoots {$victim} in the head!
execution-after-popup-ballistic-self = {CAPITALIZE($attacker)} shoots {REFLEXIVE($victim)} in the head!

# laser
execution-before-popup-laser = {CAPITALIZE($attacker)} presses the barrel of {THE($tool)} against the side of {$victim}'s head.
execution-before-popup-laser-self = {CAPITALIZE($attacker)} presses the barrel of {THE($tool)} against the side of {POSS-ADJ($victim)} head.
execution-after-popup-laser = {CAPITALIZE($attacker)} melts the inside of {$victim}'s skull!
execution-after-popup-laser-self = {CAPITALIZE($attacker)} melts the inside of {POSS-ADJ($victim)} skull!

# slash
execution-before-popup-slash = {CAPITALIZE($attacker)} readies the blade of {THE($tool)} against {$victim}'s throat.
execution-before-popup-slash-self = {CAPITALIZE($attacker)} readies the blade of {THE($tool)} against {POSS-ADJ($victim)} throat.
execution-after-popup-slash = {CAPITALIZE($attacker)} slits {$victim}'s throat!
execution-after-popup-slash-self = {CAPITALIZE($attacker)} slits {POSS-ADJ($victim)} throat!

# pierce
execution-before-popup-pierce = {CAPITALIZE($attacker)} readies the tip of {THE($tool)} against {$victim}'s chest.
execution-before-popup-pierce-self = {CAPITALIZE($attacker)} readies the tip of {THE($tool)} against {POSS-ADJ($victim)} chest.
execution-after-popup-pierce = {CAPITALIZE($attacker)} plunges {THE($tool)} into {$victim}'s chest!
execution-after-popup-pierce-self = {CAPITALIZE($attacker)} plunges {THE($tool)} into {POSS-ADJ($victim)} chest!